-  */
-inline uint16_t ADC_GetDataVrefIntmV(void)
-{
-  return (LL_ADC_CALC_DATA_TO_VOLTAGE(ADC_VREFPLUS_VALUE, ADCRawData[1U], LL_ADC_RESOLUTION_12B));
-}
