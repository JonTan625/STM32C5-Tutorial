-  }
-
-  if (BuffersMatch(BufferA, RxBuffer, BUFFER_SIZE) == 0)
-  {
-    goto _app_process_exit;
-  }
-
-  /** Manage received messages in Rx FIFO 1
-    * Check FIFO level, then get message and check data
