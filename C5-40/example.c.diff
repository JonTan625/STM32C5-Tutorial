-  */
-static uint8_t BuffersMatch(const uint8_t *buffer1, uint8_t *buffer2, uint16_t buffer_length)
-{
-  for (uint8_t i = 0; i < buffer_length ; i++)
-  {
-    if (*buffer1 != *buffer2)
