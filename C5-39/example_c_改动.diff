+/** brief:  (re)initializes I3C1 and applies the 400 kHz timing; used after a failed transfer
+  */
+static hal_status_t I3cStart(void)
+{
+  Reinits++;
+  mx_example_i3c_deinit();
+  pI3C = mx_example_i3c_init();
+  if (pI3C == NULL)
+  {
+    return HAL_ERROR;
+  }
+  return PrepareTiming();
+}
